// IMPEX Garage — Phase 1 data model. See the repo README for the
// design rationale (why FloorTaskLog merges "floor history" and
// "floor task log", the routing model, etc).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SERVICE_ADVISOR
  FLOOR_TECH
  PARTS_OFFICE
  AFTER_SALES
  ACCOUNTING
  SENIOR_MANAGEMENT
  IT_ADMIN
}

enum JobType {
  WARRANTY
  PAID
  INSURANCE
}

enum JobStatus {
  QUEUED
  IN_PROGRESS
  BLOCKED
  DONE
  CLOSED
}

enum BlockerReason {
  PART
  CUSTOMER_APPROVAL
  INSURANCE_WARRANTY_APPROVAL
  OTHER_FLOOR
  OTHER
}

enum QcStatus {
  PENDING
  PASSED
  FAILED
}

enum AfterSalesStatus {
  NOT_READY
  READY
  HANDED_OFF
}

enum PartsRequisitionStatus {
  REQUESTED
  CONFIRMED_IN_STOCK
  BACKORDERED
  FULFILLED
}

enum JobEventType {
  CREATED
  INTAKE_EDITED
  FLOOR_ENTERED
  FLOOR_EXITED
  STATUS_CHANGED
  BLOCKER_FLAGGED
  BLOCKER_CLEARED
  QC_UPDATED
  AFTER_SALES_UPDATED
  CLOSED
  PARTS_REQUESTED
  PARTS_STATUS_CHANGED
}

// A staff member. entraObjectId is null for dev-stub accounts and gets
// populated once real Entra ID SSO is wired up (Phase 1 follow-up) —
// the rest of the app only ever depends on `role`, never on how the
// user authenticated.
model User {
  id            String   @id @default(uuid())
  entraObjectId String?  @unique
  displayName   String
  email         String   @unique
  role          Role
  assignedFloor Int? // set for FLOOR_TECH users normally stationed on one floor
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())

  createdJobs        Job[]              @relation("JobCreatedBy")
  qcJobs             Job[]              @relation("JobQcBy")
  floorTaskLogsOpened FloorTaskLog[]    @relation("FloorTaskLogOpenedBy")
  floorAssignments   FloorTaskLogTechnician[]
  jobEvents          JobEvent[]
  partsRequisitions  PartsRequisition[]

  @@map("users")
}

// The Job / Repair Order — one persistent record per car visit (Section 4).
// currentFloor + status reflect where the car is *right now*; the full
// path is reconstructed from FloorTaskLog rows, not stored redundantly here.
model Job {
  id      String @id @default(uuid())
  jobNumber String @unique // e.g. IMX-20260909-0001

  vin          String?
  plate        String
  customerName String
  customerPhone String?

  intakeComplaint String
  intakeCategory  String
  jobType         JobType

  currentFloor Int? // null once CLOSED
  status       JobStatus @default(QUEUED)

  blockerReasonCode BlockerReason?
  blockerNote       String?

  qcStatus QcStatus @default(PENDING)
  qcById   String?
  qcBy     User?    @relation("JobQcBy", fields: [qcById], references: [id])
  qcAt     DateTime?

  afterSalesStatus AfterSalesStatus @default(NOT_READY)

  createdById String
  createdBy   User   @relation("JobCreatedBy", fields: [createdById], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  closedAt  DateTime?

  floorTaskLogs     FloorTaskLog[]
  events            JobEvent[]
  partsRequisitions PartsRequisition[]

  @@index([status])
  @@index([currentFloor])
  @@index([plate])
  @@index([vin])
  @@map("jobs")
}

// One row per floor visit — merges the "floor history" and "floor task
// log" from Section 4 into a single append-only table: entered_at/
// exited_at give the routing timeline, technicians/hours/notes give the
// work log, for the same visit.
model FloorTaskLog {
  id    String @id @default(uuid())
  jobId String
  job   Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  floor  Int
  status JobStatus @default(QUEUED) // this visit's own status, independent of later visits

  enteredAt           DateTime  @default(now())
  exitedAt            DateTime?
  completionTimestamp DateTime?
  notes               String?

  openedById String
  openedBy   User   @relation("FloorTaskLogOpenedBy", fields: [openedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  technicians       FloorTaskLogTechnician[]
  partsRequisitions PartsRequisition[]

  @@index([jobId])
  @@index([floor, status])
  @@map("floor_task_logs")
}

// Many-to-many: a floor visit can have multiple technicians, each with
// their own logged hours ("technician(s) assigned, hours logged").
model FloorTaskLogTechnician {
  id             String       @id @default(uuid())
  floorTaskLogId String
  floorTaskLog   FloorTaskLog @relation(fields: [floorTaskLogId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id])
  hoursLogged    Decimal?     @db.Decimal(5, 2)

  @@unique([floorTaskLogId, userId])
  @@map("floor_task_log_technicians")
}

// Append-only audit trail across the whole job — status/floor/blocker/QC/
// after-sales changes all land here so any team can see "what happened
// and when" without re-deriving it from other tables.
model JobEvent {
  id    String @id @default(uuid())
  jobId String
  job   Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  eventType JobEventType
  fromValue String?
  toValue   String?
  note      String?

  actorId String
  actor   User   @relation(fields: [actorId], references: [id])

  createdAt DateTime @default(now())

  @@index([jobId, createdAt])
  @@map("job_events")
}

// Manual-entry parts requisition (Phase 1: no IMAD integration — Section 6).
model PartsRequisition {
  id    String @id @default(uuid())
  jobId String
  job   Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  floorTaskLogId String?
  floorTaskLog   FloorTaskLog? @relation(fields: [floorTaskLogId], references: [id])

  floorRequested  Int
  partDescription String
  quantity        Int    @default(1)
  status          PartsRequisitionStatus @default(REQUESTED)

  requestedById String
  requestedBy   User   @relation(fields: [requestedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([jobId])
  @@map("parts_requisitions")
}
